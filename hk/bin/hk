#!/usr/bin/env ruby

begin
  # If run via `bundle exec hk ...`, bundler/setup will handle load paths
  # for gems (like Thor) and for 'hk' itself (if Gemfile->gemspec is correct).
  require 'bundler/setup'
rescue LoadError
  # Fallback if 'bundler/setup' fails.
  # This adds hk/lib to the load path so `require 'hk'` and `require 'hk/cli'` work.
  # __FILE__ is .../hk/bin/hk. So, '../lib' is .../hk/lib.
  lib_path = File.expand_path('../lib', __FILE__)
  $:.unshift(lib_path) unless $:.include?(lib_path)
end

# Require the main hk library to define HK module, HK::VERSION etc.
require 'hk'
# Require the CLI definitions
require 'hk/cli' # This will be found in hk/lib/hk/cli.rb

# Start the Thor CLI
HK::CLI.start(ARGV)
